<Window x:Class="Svalka.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СВАЛКА" Icon="pack://application:,,,/Assets/svalka.ico"
        Width="460" Height="820" MinWidth="380" MinHeight="560"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Fg}"
        FontFamily="{StaticResource Inter}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding DoneHeaderText}" Margin="0,18,0,4"
                           Visibility="{Binding ShowDoneHeader, Converter={StaticResource Vis}}"/>
                <Border x:Name="Row" Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Div}"
                        BorderThickness="0,0,0,1" AllowDrop="True" Padding="0,14"
                        DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop"
                        MouseRightButtonUp="Row_RightClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <!-- Checkbox (tasks, shopping) -->
                        <Border x:Name="Check" Width="22" Height="22" Margin="0,1,0,0" HorizontalAlignment="Left"
                                VerticalAlignment="Top" BorderThickness="2" BorderBrush="{DynamicResource B.Fg}"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Row_Toggle"
                                ToolTip="Отметить выполненным"
                                Visibility="{Binding IsCheckable, Converter={StaticResource Vis}}">
                            <TextBlock x:Name="CheckMark" Text="✓" FontSize="14" FontWeight="Bold" Visibility="Collapsed"
                                       Foreground="{DynamicResource B.AccentText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <!-- Link arrow -->
                        <TextBlock Text="↗" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource B.Rem}"
                                   VerticalAlignment="Top" Margin="0,-4,0,0"
                                   Visibility="{Binding IsLink, Converter={StaticResource Vis}}"/>
                        <!-- Thought date instead of a checkbox -->
                        <StackPanel Visibility="{Binding IsThought, Converter={StaticResource Vis}}" Margin="0,1,0,0">
                            <TextBlock x:Name="Day" Text="{Binding DayText}" FontFamily="{StaticResource Mono}" FontSize="15"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource B.Sec}"/>
                            <TextBlock x:Name="Month" Text="{Binding MonthText}" Style="{StaticResource Caption}" FontSize="10"/>
                        </StackPanel>

                        <!-- Text -->
                        <StackPanel Grid.Column="1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Row_Open">
                            <TextBlock Text="● ЗАКРЕПЛЕНО" Style="{StaticResource Caption}" FontSize="10"
                                       Foreground="{DynamicResource B.Rem}" Margin="0,0,0,4"
                                       Visibility="{Binding ShowPinnedCaption, Converter={StaticResource Vis}}"/>
                            <TextBlock x:Name="Title" Text="{Binding Title}" TextWrapping="Wrap" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource B.Fg}" LineHeight="22"/>
                            <TextBlock Text="{Binding Url}" FontFamily="{StaticResource Mono}" FontSize="12"
                                       Foreground="{DynamicResource B.Sec}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasUrl, Converter={StaticResource Vis}}"/>
                            <TextBlock x:Name="Reminder" Text="{Binding ReminderText}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource B.Rem}" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasReminder, Converter={StaticResource Vis}}"/>
                        </StackPanel>

                        <!-- Quick action on hover: to trash / restore -->
                        <Button x:Name="Quick" Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,2"
                                VerticalAlignment="Top" Visibility="Hidden" Click="Row_Quick" ToolTip="В корзину">
                            <TextBlock x:Name="QuickText" Text="✕" FontSize="13" Foreground="{DynamicResource B.Sec}"/>
                        </Button>

                        <!-- Drag handle -->
                        <TextBlock x:Name="Handle" Grid.Column="3" Text="⋮" FontSize="20" Foreground="{DynamicResource B.Sec}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,4,0" Padding="6,0"
                                   Background="Transparent" Cursor="SizeNS" ToolTip="Потяни, чтобы переставить"
                                   PreviewMouseLeftButtonDown="Handle_MouseDown" PreviewMouseMove="Handle_MouseMove"/>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Completed}" Value="True">
                    <Setter TargetName="Check" Property="Background" Value="{DynamicResource B.Accent}"/>
                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="Title" Property="FontSize" Value="15"/>
                    <Setter TargetName="Check" Property="ToolTip" Value="Вернуть в список"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource B.Sec}"/>
                    <Setter TargetName="Reminder" Property="Foreground" Value="{DynamicResource B.Sec}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsThought}" Value="True">
                    <Setter TargetName="Title" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="Title" Property="LineHeight" Value="23"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DateAccent}" Value="True">
                    <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource B.Rem}"/>
                    <Setter TargetName="Month" Property="Foreground" Value="{DynamicResource B.Rem}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InTrash}" Value="True">
                    <Setter TargetName="Check" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="Check" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="Handle" Property="Text" Value="⋯"/>
                    <Setter TargetName="Handle" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="Handle" Property="ToolTip" Value="{x:Null}"/>
                    <Setter TargetName="QuickText" Property="Text" Value="↺"/>
                    <Setter TargetName="Quick" Property="ToolTip" Value="Восстановить"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource B.Sheet}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Quick" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource B.Hover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Margin="20,10,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Settings_Click"
                        ToolTip="Тема и запуск" Visibility="{Binding NotInTrash, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="НАСТРОЙКИ ◐" Foreground="{DynamicResource B.Fg}"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Data_Click"
                        ToolTip="Копии и Google Диск" Visibility="{Binding NotInTrash, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="ДАННЫЕ" Foreground="{DynamicResource B.Fg}"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="TrashToggle_Click"
                        Visibility="{Binding InTrash, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="НАЗАД" Foreground="{DynamicResource B.Fg}"/>
                </Button>
                <TextBlock x:Name="HeaderCaption" Style="{StaticResource Caption}" Text="{Binding HeaderCaption}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Big title -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{Binding BigTitle}" FontSize="44" FontWeight="Black" Foreground="{DynamicResource B.Fg}"
                           LineHeight="46" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock Text="_" FontSize="44" FontWeight="Black" Foreground="{DynamicResource B.Accent}"
                           LineHeight="46" LineStackingStrategy="BlockLineHeight"/>
            </StackPanel>

            <!-- Section and count -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding SectionCaption}" Foreground="{DynamicResource B.Accent}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Count}" FontSize="34" FontWeight="ExtraBold" Foreground="{DynamicResource B.Fg}"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding CountText}" FontSize="15" Foreground="{DynamicResource B.Sec}"
                               VerticalAlignment="Bottom" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="_" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource B.Accent}"
                               VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </StackPanel>
            </StackPanel>

            <!-- List header -->
            <Border Grid.Row="3" Margin="0,10,0,0" BorderBrush="{DynamicResource B.Div}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="TrashToggle_Click"
                            ToolTip="Корзина">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TrashButtonText}"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="ClearPurchased_Click"
                            Visibility="{Binding ShowClearPurchased, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ClearPurchasedText}"
                                   Foreground="{DynamicResource B.Rem}"/>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ListCaption}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- List -->
            <ScrollViewer x:Name="ListScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" Focusable="False"
                          PanningMode="VerticalOnly">
                <ItemsControl x:Name="List" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RowTemplate}"
                              Focusable="False"/>
            </ScrollViewer>
            <TextBlock Grid.Row="4" Text="{Binding EmptyText}" TextAlignment="Center" FontSize="16" LineHeight="24"
                       Foreground="{DynamicResource B.Sec}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>

            <!-- Undo banner -->
            <Border Grid.Row="5" Margin="0,6,0,8" Background="{DynamicResource B.Sheet}" BorderBrush="{DynamicResource B.Div}"
                    BorderThickness="1" Padding="12,0,0,0" Visibility="{Binding HasUndo, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Undo_Click" Padding="10,10">
                        <TextBlock Style="{StaticResource Caption}" Text="ОТМЕНИТЬ" FontSize="10" Foreground="{DynamicResource B.Rem}"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="10" Text="{Binding UndoCountdown}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="10" Text="{Binding UndoText}"
                               Foreground="{DynamicResource B.Fg}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Composer -->
            <Border Grid.Row="6" Background="{DynamicResource B.Accent}" Padding="16,8,8,8" MinHeight="60" Margin="0,4,0,12"
                    Visibility="{Binding NotInTrash, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="44" Height="44" Background="{DynamicResource B.AccentText}"
                            Cursor="Hand" MouseLeftButtonUp="Add_Click" VerticalAlignment="Bottom" ToolTip="Добавить (Enter)">
                        <TextBlock Text="+" FontSize="28" FontWeight="Medium" Foreground="{DynamicResource B.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Placeholder}" FontSize="14" FontWeight="ExtraBold" IsHitTestVisible="False"
                                   Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Center" Margin="2,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding InputEmpty, Converter={StaticResource Vis}}"/>
                        <TextBox x:Name="Composer" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="SemiBold"
                                 Foreground="{DynamicResource B.AccentText}" CaretBrush="{DynamicResource B.AccentText}"
                                 SelectionBrush="{DynamicResource B.AccentText}" TextWrapping="Wrap" AcceptsReturn="True"
                                 MaxHeight="190" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                 PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Tabs -->
            <UniformGrid x:Name="Tabs" Grid.Row="7" Rows="1" Visibility="{Binding NotInTrash, Converter={StaticResource Vis}}"/>
        </Grid>

        <!-- Short message, like a Toast on Android -->
        <Border x:Name="Snackbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,150"
                Background="{DynamicResource B.Fg}" CornerRadius="8" Padding="16,10" Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SnackbarText" Foreground="{DynamicResource B.Bg}" FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Dialog layer -->
        <Grid x:Name="Overlay" Visibility="Collapsed">
            <Border Background="{DynamicResource B.Scrim}" MouseLeftButtonDown="Scrim_MouseDown"/>
            <ContentControl x:Name="DialogHost" Margin="18" MaxWidth="480" VerticalAlignment="Center"
                            HorizontalAlignment="Stretch" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
