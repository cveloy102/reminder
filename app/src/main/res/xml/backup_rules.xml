<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The sync login (token, server, cursor) belongs to this phone: after a restore on a new
     phone the app asks to sign in again and compares all records with the server instead of trusting old state. -->
<full-backup-content>
    <exclude domain="sharedpref" path="sync.xml" />
    <exclude domain="file" path="sync_state.json" />
</full-backup-content>
