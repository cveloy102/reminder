<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Records are backed up; the sync login (token, server, cursor) stays on this phone only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="file" path="sync_state.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="file" path="sync_state.json" />
    </device-transfer>
</data-extraction-rules>
